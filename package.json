{
  "name": "zrelease",
  "version": "0.1.0",
  "private": true,
  "description": "Qualify, publish, and verify exact Rust library archives",
  "author": "zsumz <shawn@zsumz.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "node scripts/build.ts",
    "check:dist": "node scripts/build.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run check:dist && npm test",
    "test:cargo": "node scripts/cargo-fixture.ts",
    "test:workspace": "node scripts/workspace-fixture.ts"
  },
  "dependencies": {
    "smol-toml": "1.8.0",
    "tar-stream": "3.2.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "yaml": "2.8.3"
  }
}
